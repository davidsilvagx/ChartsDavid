# Configurar também no ambiente de Functions da Vercel/Netlify.
LASTFM_API_KEY=

# Identificadores públicos opcionais dos aplicativos cadastrados pelo responsável.
# Configurar no build para habilitar login sem pedir Client ID aos usuários.
# Nunca colocar Client Secret ou tokens em variáveis VITE_.
VITE_SPOTIFY_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Sincronização entre aparelhos (opcional). Upstash Redis pelo Vercel Marketplace injeta estas variáveis.
# Sem elas, /api/sync responde 503 e o app oferece apenas Exportar/Importar projeto.
KV_REST_API_URL=
KV_REST_API_TOKEN=
