# Configurar também no ambiente de Functions da Vercel/Netlify.
LASTFM_API_KEY=

# Identificadores públicos opcionais dos aplicativos cadastrados pelo responsável.
# Configurar no build para habilitar login sem pedir Client ID aos usuários.
# Nunca colocar Client Secret ou tokens em variáveis VITE_.
VITE_SPOTIFY_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Sincronização entre aparelhos e assinaturas de push: Vercel Blob privado do projeto
# (vercel blob create-store <nome> --access private). Sem token, /api/sync e /api/push respondem 503.
BLOB_READ_WRITE_TOKEN=
# Alternativa suportada: Upstash Redis (KV_REST_API_URL / KV_REST_API_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Notificações com o app fechado (Web Push). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Segredo do Cron do Vercel (/api/push-cron, 1×/dia no plano Hobby).
CRON_SECRET=

# Supabase public client configuration (RLS is mandatory; never expose service_role)
VITE_SUPABASE_URL=https://qyzelexnjoquhrlcelvz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_nmcr3oTT40jamGIeP9Vgvw_RP4CaNEB
